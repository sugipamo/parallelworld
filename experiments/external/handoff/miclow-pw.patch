From aa1872426486eaffcc47dfd3bcd028f5357bc9a5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 09:35:36 +0000
Subject: [PATCH 3/3] Make the places say what was laid down

Cargo.toml now gives the licence as MIT, as LICENSE does. The README's
configuration section uses the keys the code accepts (environment_vars,
subscribe_topics). The Python client's README lists the methods the
client has, with their signatures, and no longer the four it does not.

The configuration and the client's README were changed by an agent and
read back by a reader shown only the new text; Cargo.toml was written
by its pattern and read back the same way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016CDHSwZWzVoy1TC6nxh6gX
---
 Cargo.toml       |  2 +-
 README.md        |  4 ++--
 pw-log.jsonl     | 10 ++++++++++
 python/README.md |  8 ++++----
 4 files changed, 17 insertions(+), 7 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 8b7ff4d..af2acda 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -5,7 +5,7 @@ edition = "2021"
 authors = ["sugipamo <sugipamo@gmail.com>"]
 description = "Miclow - A lightweight orchestration system for asynchronous task execution"
 repository = "https://github.com/sugipamo/miclow"
-license = "MIT OR Apache-2.0"
+license = "MIT"
 keywords = ["orchestration", "async", "task", "execution", "lightweight"]
 categories = ["asynchronous", "command-line-utilities"]
 
diff --git a/README.md b/README.md
index f0f8987..d76ee2f 100644
--- a/README.md
+++ b/README.md
@@ -109,8 +109,8 @@ task_name = "example_task"
 command = "実行するコマンド"
 args = ["引数1", "引数2"]
 working_directory = "/作業ディレクトリ"
-environment = { VAR1 = "value1", VAR2 = "value2" }
-topics = ["購読するトピック1", "トピック2"]
+environment_vars = { VAR1 = "value1", VAR2 = "value2" }
+subscribe_topics = ["購読するトピック1", "トピック2"]
 ```
 
