[
 {
  "name": "default dependence class",
  "type": "String",
  "gloss": "the name of the copula class used by default for evidence on one target",
  "places": [
   "docs/spec.md::3. モデル",
   "docs/spec.md::2. v0.1 からの変更",
   "docs/symbols.md::7. 証拠 ― 仮想証拠・コピュラ・一般化ベイズ則",
   {
    "at": "pw/kernel.py::Kernel.__init__",
    "read": {
     "find": "dependence=\"(\\w+)\"",
     "as": "string"
    }
   }
  ]
 },
 {
  "name": "axioms a proof may depend on",
  "type": "List String",
  "gloss": "the axioms an accepted proof may depend on, sorted alphabetically (capital letters first)",
  "places": [
   "docs/spec.md::5. Lean Gate",
   {
    "at": "pw/lean_gate.py::ALLOWED_AXIOMS",
    "read": {
     "find_all": "\"([^\"]+)\"",
     "as": "string",
     "sort": true
    }
   }
  ]
 },
 {
  "name": "largest component inference solves",
  "type": "Nat",
  "gloss": "the largest number of atoms in a connected component that inference still solves",
  "places": [
   "docs/spec.md::7. 未解決",
   {
    "at": "pw/kernel.py::Kernel.__init__",
    "read": {
     "find": "max_atoms=(\\d+)",
     "as": "nat"
    }
   }
  ]
 },
 {
  "name": "names of the MCP tools",
  "type": "List String",
  "gloss": "the names of the MCP tools offered to workers, sorted alphabetically",
  "places": [
   "docs/spec.md::4. 操作（MCPツール）",
   {
    "at": "pw/mcp_server.py",
    "read": {
     "find_all": "@mcp\\.tool\\(\\)\\ndef (\\w+)\\(",
     "as": "string",
     "sort": true
    }
   }
  ]
 },
 {
  "name": "default threshold, in thousandths",
  "type": "Nat",
  "gloss": "the lower bound a decision must reach by default",
  "places": [
   {
    "at": "pw/orchestrator.py::main",
    "read": {
     "find": "\"--threshold\", type=float, default=([0-9.]+)",
     "as": "permille"
    }
   },
   {
    "at": "pw/check.py::main",
    "read": {
     "find": "\"--threshold\", type=float, default=([0-9.]+)",
     "as": "permille"
    }
   },
   {
    "at": "pw/maintain.py::main",
    "read": {
     "find": "\"--threshold\", type=float, default=([0-9.]+)",
     "as": "permille"
    }
   }
  ]
 },
 {
  "name": "Lean version",
  "type": "String",
  "gloss": "the Lean version Gamma is pinned to",
  "places": [
   {
    "at": "lean/lean-toolchain",
    "read": {
     "find": ":v([0-9.]+)",
     "as": "string"
    }
   },
   {
    "at": "experiments/selfcheck/lean/lean-toolchain",
    "read": {
     "find": ":v([0-9.]+)",
     "as": "string"
    }
   },
   {
    "at": ".github/workflows/decisions.yml",
    "read": {
     "find": "LEAN_VERSION: ([0-9.]+)",
     "as": "string"
    }
   }
  ]
 }
]